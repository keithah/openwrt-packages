{
  "sources": [
    {
      "product": "starwatch",
      "repository": "keithah/openwrt-starwatch",
      "packages": ["gl-app-starwatch", "luci-app-starwatch", "starwatchd"],
      "ipk_pattern": "^(?P<package>starwatchd|luci-app-starwatch|gl-app-starwatch)_(?P<version>[A-Za-z0-9.+~:-]+)_(?P<architecture>aarch64_cortex-a53|all)\\.ipk$",
      "installer": "install-starwatch.sh",
      "installer_source": "package/install.sh"
    },
    {
      "product": "wattline",
      "repository": "keithah/openwrt-wattline",
      "packages": ["gl-app-wattline", "luci-app-wattline", "wattline-bt", "wattline-rtl8761b", "wattlined"],
      "ipk_pattern": "^(?P<package>wattlined|wattline-bt|wattline-rtl8761b|luci-app-wattline|gl-app-wattline)_(?P<version>[A-Za-z0-9.+~:-]+)_(?P<architecture>aarch64_cortex-a53|all)\\.ipk$",
      "installer": "install-wattline.sh",
      "installer_source": "package/install.sh"
    },
    {
      "product": "speedtest",
      "repository": "keithah/openwrt-ookla-speedtest-cli",
      "packages": ["ookla-speedtest-cli"],
      "ipk_pattern": "^(?P<package>ookla-speedtest-cli)_(?P<version>[A-Za-z0-9.+~:-]+)_(?P<architecture>aarch64_cortex-a53)\\.ipk$",
      "installer": "install-ookla-speedtest-cli.sh",
      "installer_source": "scripts/install.sh"
    }
  ]
}
